unsigned int cc=0;

void handleRoot(AsyncWebServerRequest *request) { // This function is called by the script to update the sensor value, in this example random data!

  nm._request = request;
  nm._request->send(200, "text/html", Web_page); //Send web page
}

void handleTEMP(AsyncWebServerRequest *request) { // This function is called by the script to update the sensor value, in this example random data!
  // temp = String(bme.readTemperature(),2);
  // server.send(200, "text/plain", temp));
  nm._request = request;
  nm._request->send(200, "text/plain", String((float)random(195,209)/10,2)); //Send sensor reading when there's a client ajax request
}



void handleHUMI(AsyncWebServerRequest *request) { // This function is called by the script to update the sensor value, in this example random data!
  nm._request = request;
  nm._request->send(200, "text/plain", String((float)random(501,523)/10,2)); //Send sensor reading when there's a client ajax request
}

void handlePRES(AsyncWebServerRequest *request) { // This function is called by the script to update the sensor value, in this example random data!
  nm._request = request;
  nm._request->send(200, "text/plain", String((float)random(10161,10169)/10,2)); //Send sensor reading when there's a client ajax request
}


#ifdef OLDCODE
void handleZend(AsyncWebServerRequest *request) 
{
  static unsigned long count=0;
  nm._request = request;
  String ligne;


  count ++;
  DEBUG1("----------------------");
  DEBUG2("handleZend() ",count);
  

        // char str[80];
        // sprintf(str, "data: Send %d \n\n", cc);
        // return str;

  AsyncWebServerResponse *response = nm._request->beginChunkedResponse("text/event-stream", 
    [](uint8_t *buffer, size_t maxLen, size_t index) -> size_t {
        if(index){ //already sent
            return 0;
        }
        return snprintf((char *)buffer, maxLen, "data: Send %d \n\n", cc);
    });
  response->addHeader("Cache-Control", "no-cache");
  nm._request->send ( response ); 
}
#endif

/*
 * initialisation du WIFI + Web
 */
void setupWeb()
{
  DEBUG1("Configuration Wifi & webserver ...");
  IPAddress ip;
  IPAddress masqueip;
  ip.fromString(WIFI_IP);
  masqueip.fromString(WIFI_MASQUE);
  nm.connectWifiAP (WIFI_SSI,WIFI_PASSWORD,ip,ip,masqueip);
  nm.on("/",handleRoot);
//  nm.on("/zend",handleZend);
  nm.on("/TEMPread",handleTEMP);
  nm.on("/HUMIread",handleHUMI);
  nm.on("/PRESread",handlePRES);
  nm.begin();
}

void setup() {

  Serial.begin(115200);
  while (! Serial);
  DEBUG1("SETUP...");

  DEBUG1("  EEPROM...");
  EEPROM.begin(512);

  DEBUG1("  readParametersInEEPROM...");
  readParametersInEEPROM();

  setupWeb();
}

void loop() {
  cc++;
  if (cc>10000) cc=0;
}

